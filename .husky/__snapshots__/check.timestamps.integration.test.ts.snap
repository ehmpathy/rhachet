exports[`check.timestamps given: [case2] a stage that holds a stamp when: [t3] the line is a clock-with-no-seconds then: it halts with exit 2, and names the file and the line 1`] = `
"✋ ConstraintError: timestamps are forbidden in tracked files, prose and docs included. remove them, zero exceptions
