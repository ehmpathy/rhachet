exports[`check.timestamps given: [case3] a staged blob git cannot read when: [t0] the hook runs then: it halts with exit 1, as a malfunction, and names the file 1`] = `
"💥 MalfunctionError: check.timestamps could not read the staged blob
   └─ notes.md
"
`;
