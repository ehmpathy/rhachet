#!/bin/sh
# .what = proxy that prepends `run --skill` and delegates to rhachet
# .why = shorthand for `rhachet run --skill`
#
# .note = keyrack is short-circuited to avoid skill proxy overhead

# follow symlinks to find the real bin directory (handles pnpm hoisted mode)
# .note = POSIX shell has no const/immutable constructs; mutation is the only mechanism
#         for loops. this is the standard idiom used by git, docker, and all major shell projects.
EXECUTABLE="$0"
LINK_DEPTH=0
while [ -L "$EXECUTABLE" ]; do
  LINK_DEPTH=$((LINK_DEPTH + 1))
  if [ "$LINK_DEPTH" -gt 20 ]; then
    echo "error: symlink cycle detected after 20 iterations" >&2
    exit 1
  fi
  SCRIPT_DIR="$(cd "$(dirname "$EXECUTABLE")" && pwd)"
  EXECUTABLE="$(readlink "$EXECUTABLE")"
  case "$EXECUTABLE" in
    /*) ;;
    *) EXECUTABLE="$SCRIPT_DIR/$EXECUTABLE" ;;
  esac
done
SCRIPT_DIR="$(cd "$(dirname "$EXECUTABLE")" && pwd)"

# short-circuit help commands
if [ "$1" = "help" ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  exec "$SCRIPT_DIR/run" run --help
fi

# short-circuit list command
if [ "$1" = "list" ]; then
  shift
  # handle list help specially (pass help as pattern so action handler sees it)
  if [ "$1" = "--help" ] || [ "$1" = "-h" ] || [ "$1" = "help" ]; then
    exec "$SCRIPT_DIR/run" run list help
  fi
  exec "$SCRIPT_DIR/run" run list "$@"
fi

# short-circuit the boot/cost aliases (roles subcommands, not skills)
#
# .why = these two are the commands a human types most — `boot` fires from a hook on every
#   session, and `cost` is the surface an author returns to as they trim. the `roles` group is
#   a namespace that costs a reader keystrokes and earns them naught at a prompt.
#
# .why = and the alias is LOAD-BEARING rather than a convenience: the over-budget halt names
#   `rhx cost <coordinates>` as the instrument an author reaches for next. absent this route,
#   that pointer falls through to the skill proxy below and dies on a "no skill found" — a halt
#   whose one remedy names a command that errors (rule.require.errors-name-the-fix).
#
# .note = it splices the `roles` group back in rather than teach the binary a second name, so
#   ONE command contract is declared and the alias is purely a dispatch concern. `bin/run`
#   carries the same two routes, so `rhachet boot` and `rhx boot` reach one destination.
#
# .note = this SHADOWS a skill named `boot` or `cost`. that is the cost of the alias, and it
#   is paid deliberately: a role that wants those verbs still reaches them by their full
#   `rhachet run --skill <name>` form, where the roles subcommands have no second name at all.
if [ "$1" = "boot" ] || [ "$1" = "cost" ]; then
  RHACHET_SUBCOMMAND="$1"
  shift
  exec "$SCRIPT_DIR/run" roles "$RHACHET_SUBCOMMAND" "$@"
fi

# short-circuit keyrack commands (via jit path, not bun binary)
if [ "$1" = "keyrack" ]; then
  shift
  exec "$SCRIPT_DIR/run.jit" keyrack "$@"
fi

# short-circuit upgrade command (top-level rhachet command, not a skill)
if [ "$1" = "upgrade" ]; then
  shift
  exec "$SCRIPT_DIR/run.jit" upgrade "$@"
fi

# short-circuit enroll command (top-level rhachet command, not a skill)
if [ "$1" = "enroll" ]; then
  shift
  exec "$SCRIPT_DIR/run" enroll "$@"
fi

# short-circuit actor command (top-level rhachet command, not a skill)
if [ "$1" = "actor" ]; then
  shift
  exec "$SCRIPT_DIR/run" actor "$@"
fi

# short-circuit clone command (top-level rhachet command, not a skill)
if [ "$1" = "clone" ]; then
  shift
  exec "$SCRIPT_DIR/run" clone "$@"
fi

# short-circuit init command (top-level rhachet command, not a skill)
if [ "$1" = "init" ]; then
  shift
  # role-name alias: when the tail carries only role tokens (bare names like
  # `learner`, or sigils like `+learner` / `-learner`) and no recognized init
  # flag, expand to `init --keys --hooks --roles <tokens>` so the enrolled role
  # is ready-to-use (keyrack manifest + brain hooks) in one command.
  # mode select: any recognized flag => explicit flag mode (pass through as-is);
  # otherwise (tokens only) => alias mode (inject --keys --hooks --roles).
  # .note = no args => pass through so `rhx init` still prints usage.
  HAS_INIT_FLAG=false
  for INIT_ARG in "$@"; do
    case "$INIT_ARG" in
      --roles|--keys|--hooks|--config|--prep|--mode|-h|--help)
        HAS_INIT_FLAG=true
        break
        ;;
    esac
  done
  if [ "$HAS_INIT_FLAG" = true ] || [ "$#" -eq 0 ]; then
    # explicit flag mode (or bare `rhx init`) — pass through unchanged
    exec "$SCRIPT_DIR/run" init "$@"
  fi
  # alias mode — role tokens only, inject the ready-to-use flags
  exec "$SCRIPT_DIR/run" init --keys --hooks --roles "$@"
fi

# default: proxy to run --skill
exec "$SCRIPT_DIR/run" run --skill "$@"
