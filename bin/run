#!/bin/sh
######################################################################
# .what = shell entrypoint for rhachet CLI
# .why = routes to bun (fast) or jit (flexible) dispatcher
#
# architecture:
#   run, roles boot/cost → run.bun (bun compiled, reads the filesystem)
#   boot/cost            → the same, via the short alias below
#   *                    → run.jit (jit, imports from npm packages)
#
# .note = run.bun does finer-grained dispatch to .bc binaries
######################################################################

# resolve script directory (handles symlinks from node_modules/.bin/)
# .note = POSIX shell has no const/immutable constructs; mutation is the only mechanism
#         for loops. this is the standard idiom used by git, docker, and all major shell projects.
SCRIPT="$0"
LINK_DEPTH=0
while [ -L "$SCRIPT" ]; do
  LINK_DEPTH=$((LINK_DEPTH + 1))
  if [ "$LINK_DEPTH" -gt 20 ]; then
    echo "error: symlink cycle detected after 20 iterations" >&2
    exit 1
  fi
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT")" && pwd)"
  SCRIPT="$(readlink "$SCRIPT")"
  case "$SCRIPT" in
    /*) ;;
    *) SCRIPT="$SCRIPT_DIR/$SCRIPT" ;;
  esac
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT")" && pwd)"

case "$1" in
  run)
    # fast path: dispatch to bun, if allowlisted
    exec "$SCRIPT_DIR/run.bun" "$@"
    ;;
  roles)
    case "$2" in
      boot|cost)
        # fast path: dispatch to bun, if allowlisted
        exec "$SCRIPT_DIR/run.bun" "$@"
        ;;
      *)
        # else, use jit
        exec "$SCRIPT_DIR/run.jit" "$@"
        ;;
    esac
    ;;
  boot|cost)
    # the short alias: `rhx boot` reaches `roles boot`
    #
    # .why = these two are the commands a human types most — `boot` fires from a hook on
    #   every session, and `cost` is the surface an author returns to as they trim. the
    #   `roles` group is a namespace that costs a reader keystrokes and earns them naught
    #   at a prompt.
    #
    # .note = it splices the group back in rather than teach the binary a second name, so
    #   ONE command contract is declared and the alias is purely a dispatch concern.
    RHACHET_SUBCOMMAND="$1"
    shift
    exec "$SCRIPT_DIR/run.bun" roles "$RHACHET_SUBCOMMAND" "$@"
    ;;
  *)
    # else, use jit
    exec "$SCRIPT_DIR/run.jit" "$@"
    ;;
esac
