  "attempt": {
    "grant": {
      "env": "camp",
      "key": {
        "grade": {
          "duration": "permanent",
          "protection": "plaintext",
        },
        "secret": "$SECRET",
      },
      "org": "@all",
      "slug": "@all.camp.__TEST_SDK_MW_MACHINE_KEY__",
      "source": {
        "mech": "PERMANENT_VIA_REPLICA",
        "vault": "os.envvar",
      },
