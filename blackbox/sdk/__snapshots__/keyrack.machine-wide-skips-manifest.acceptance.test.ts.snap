    "status": "granted",
  },
  "emit": {
    "stdout": "
🔐 keyrack
   └─ @all.camp.__TEST_SDK_MW_MACHINE_KEY__
      ├─ vault: os.envvar
      ├─ mech: PERMANENT_VIA_REPLICA
      └─ status: granted 🔑
",
  },
}
`;

