// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`shell dispatch given: [case2] the bun binary the route points at when: [t0] run.bun roles cost --help then: the help render matches its snapshot: stdout-run-bun-roles-cost-help 1`] = `
"Usage: rhachet roles cost [options]

show what a boot costs, and where the tokens go

Options:
  --repo <slug>              the repository slug for the role
  --role <slug>              the role to cost
  --manifest, --what <path>  cost a declared boot.yml instead of a role
  --subject <slugs>          cost specific subjects (comma-separated or
                             repeated, subject mode only)
  --top <count>              how many batches to rank — a non-negative integer
                             (default: 10)
  --all                      cost every boot spec in this repo, as a roster
  --if-present               exit silently where the role dir is absent
  --when <caller>            who invoked this, with --all — one of hook.onBoot,
                             hook.onTool, hook.onStop, hook.onTalk
  -h, --help                 display help for command
"
`;

exports[`shell dispatch given: [case2] the bun binary the route points at when: [t1] run.bun roles boot --help then: the help render matches its snapshot: stdout-run-bun-roles-boot-help 1`] = `
"Usage: rhachet roles boot [options]

boot context from role resources (briefs and skills)

Options:
  --repo <slug>              the repository slug for the role
  --role <slug>              the role to boot resources for
  --manifest, --what <path>  boot from a declared boot.yml instead of a role
                             default
  --if-present               exit silently where the role dir is absent
  --subject <slugs>          boot specific subjects (comma-separated or
                             repeated, subject mode only)
  -h, --help                 display help for command
"
`;

exports[`shell dispatch given: [case3] the rhx alias table when: [t0] rhx boot --repo .this --role any then: the alias renders as snapshotted — on STDOUT: stdout-rhx-boot-alias 1`] = `
"<stats>
quant
  ├── files = 4
