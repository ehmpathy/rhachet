exports[`rhachet run graceful errors given: [case2] skill that exits 2 (graceful failure) when: [t0] npx rhachet run --skill graceful-fail then: stderr matches snapshot 1`] = `
"
🪨 run solid skill repo=.this/role=any/skill=graceful-fail
   └─ ✋ blocked by constraints

quota error: no commit uses granted
"
`;

exports[`rhachet run graceful errors given: [case3] skill that exits 1 (unexpected failure) when: [t0] npx rhachet run --skill unexpected-fail then: stderr matches snapshot 1`] = `
