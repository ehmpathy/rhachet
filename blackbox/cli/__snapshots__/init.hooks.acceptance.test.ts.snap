exports[`rhachet init --hooks given: [case9] a hook a human added by hand beside the dispatchers when: [t0] init --hooks re-syncs the roles then: the PreToolUse hooks match the snapshot 1`] = `
"[
  {
    "matcher": "*",
    "hooks": [
      {
        "type": "command",
        "command": "bash ./node_modules/rhachet/bin/hooks.dispatch.sh .claude/hooks.dispatch.manifest PreToolUse",
        "timeout": "__FIXTURE_TIMEOUT__",
        "author": "rhachet/hooks.dispatch"
      }
    ]
  },
  {
    "matcher": "Bash",
    "hooks": [
      {
        "type": "command",
        "command": "echo hand-added-guard",
        "timeout": 7
      }
    ]
  }
]"
`;

