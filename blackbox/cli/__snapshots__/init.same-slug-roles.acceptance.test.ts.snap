exports[`rhachet init — two repos that ship one role slug given: [case1] alpha and beta each ship role surfer when: [t0] init links both, each by its repo/role then: the repo actor boot.md carries both roles; neither is dropped 1`] = `
"<brief.say path="rhachet/intro">
# rhachet

you are enrolled via rhachet. your roles' briefs and skills follow.

- \`rhx list\` — every skill your roles grant. check it before you improvise
- \`rhx <skill> --help\` — how to call one
- \`rhx init · roles · list · run · enroll · actor · clone · keyrack · ask · act · upgrade\` — the commands; \`rhx <command> --help\` for each

entool: a tactic worth repeat becomes a skill — \`.agent/repo=.this/role=any/skills/<name>.sh\` — so the next clone runs it, never rediscovers it.

</brief.say>

<readme path=".agent/repo=alpha/role=surfer/readme.md">
# surfer, of alpha

</readme>

<brief.say path=".agent/repo=alpha/role=surfer/briefs/rule.require.longboard.md">
alpha: ride a longboard on small days

</brief.say>

<skill.say path=".agent/repo=alpha/role=surfer/skills/wax.board.sh">
#!/usr/bin/env bash
######################################################################
# .what = wax the board, as alpha does
######################################################################

# [implementation hidden - use skill to execute]
</skill.say>

<readme path=".agent/repo=beta/role=surfer/readme.md">
# surfer, of beta

</readme>

<brief.say path=".agent/repo=beta/role=surfer/briefs/rule.require.shortboard.md">
beta: ride a shortboard on big days

</brief.say>

<skill.say path=".agent/repo=beta/role=surfer/skills/wax.board.sh">
#!/usr/bin/env bash
######################################################################
# .what = wax the board, as beta does
######################################################################

# [implementation hidden - use skill to execute]
</skill.say>

"
`;

exports[`rhachet init — two repos that ship one role slug given: [case1] alpha and beta each ship role surfer when: [t1] a skill both roles ship is run by bare name then: the refusal matches its snapshot 1`] = `
{
  "stderr": "
✋ ConstraintError: multiple skills found for "wax.board":
  - repo=alpha role=surfer
  - repo=beta role=surfer

use --repo and/or --role to disambiguate

{
  "input": {
    "slugSkill": "wax.board"
  },
  "matches": [
    {
      "slug": "wax.board",
      "path": "/TMP_REPO/.agent/repo=alpha/role=surfer/skills/wax.board.sh",
      "slugRepo": "alpha",
      "slugRole": "surfer"
    },
    {
      "slug": "wax.board",
      "path": "/TMP_REPO/.agent/repo=beta/role=surfer/skills/wax.board.sh",
      "slugRepo": "beta",
      "slugRole": "surfer"
    }
  ]
}

[args] run,--skill,wax.board

",
  "stdout": "",
}
`;

exports[`rhachet init — two repos that ship one role slug given: [case1] alpha and beta each ship role surfer when: [t2] the skill is run with --repo then: the run stdout matches its snapshot 1`] = `
