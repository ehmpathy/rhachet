// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`brain config: auth, grove, repo (real claude) given: [case1] a repo whose layout rhx init built when: [t0] the brain dir is read then: the layout and the repo settings, locked to a snapshot (2, 3, 6) 1`] = `
{
  "layout": [
    ".gitignore (file)",
    ".home/",
    ".home/.claude/",
    ".home/.claude/settings.json → $HOME/.claude/settings.json",
    ".home/.gitignore (file)",
    "AGENTS.md (file)",
    "CLAUDE.md → AGENTS.md",
    "boot.md (file)",
    "settings.json → settings.of.grove.json",
    "settings.local.json → settings.of.repo.json",
    "settings.of.grove.json → .home/.claude/settings.json",
    "settings.of.repo.json (file)",
  ],
  "repoSettings": {
    "claudeMdExcludes": [
      "**/home/*/.claude/CLAUDE.md",
      "**/Users/*/.claude/CLAUDE.md",
      "/root/.claude/CLAUDE.md",
      "/github/home/.claude/CLAUDE.md",
      "**/CLAUDE.local.md",
    ],
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "author": "repo=test/role=tester",
              "command": "touch tester-boot.marker",
              "type": "command",
            },
          ],
          "matcher": "*",
        },
      ],
    },
    "permissions": {
      "allow": [
        "Bash(bash probe-repo.sh)",
      ],
    },
  },
}
`;

exports[`brain config: auth, grove, repo (real claude) given: [case2] a plain claude at the repo root when: [t0] it runs the repo probe and the grove probe then: the outcome, locked to a snapshot (2, 3) 1`] = `
