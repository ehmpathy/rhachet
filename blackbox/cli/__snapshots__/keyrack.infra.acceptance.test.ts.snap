exports[`keyrack infra init (acceptance) given: [case1] the keyrack cli is available when: [t0] the caller asks for \`keyrack infra init --help\` then: the help output (the member contract) stays locked 1`] = `
"Usage: rhachet keyrack infra init [options]

init the $org/keyrack-infra repo and github-apps registry

Options:
  --org <org>  org to init keyrack-infra for
  --json       output as json (robot mode)
  -h, --help   display help for command"
`;

exports[`keyrack infra init (acceptance) given: [case2] the caller omits the required --org option when: [t0] \`keyrack infra init\` runs with no --org then: the rejection message (negative-path contract) stays locked 1`] = `"[commander error] error: required option '--org <org>' not specified"`;

