exports[`rhx enroll — a role modded via .agent/repo=.mods given: [case3] a mod whose of names no linked role when: [t0] a clone is enrolled with the role then: the refusal stderr matches its snapshot 1`] = `
"
✋ ConstraintError: the mod of role=surfer is refused: its \`of: ghost/surfer\` names a role that is not linked

{
  "mod": ".agent/repo=.mods/role=surfer/",
  "subject": "boot.yml",
  "did you mean": "test/surfer",
  "fix": "link it first (rhx init --roles ghost/surfer), or point \`of:\` at a linked role"
}

[args] enroll,claude,--roles,surfer

"
`;

exports[`rhx enroll — a role modded via .agent/repo=.mods given: [case4] a mod of a .this role (F18) when: [t0] a clone is enrolled with the .this role then: the refusal stderr matches its snapshot 1`] = `
"
✋ ConstraintError: the mod of role=surfer is refused: its \`of: .this/surfer\` names a role this repo owns

{
  "mod": ".agent/repo=.mods/role=surfer/",
  "subject": "boot.yml",
  "fix": "edit .agent/repo=.this/role=surfer/ in place, and delete the mod"
}

[args] enroll,claude,--roles,surfer

"
`;

exports[`rhx enroll — a role modded via .agent/repo=.mods given: [case5] two linked roles of one slug, a mod whose bare of names both when: [t0] a clone is enrolled with both then: the refusal stderr matches its snapshot 1`] = `
