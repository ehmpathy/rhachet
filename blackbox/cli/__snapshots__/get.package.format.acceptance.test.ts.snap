exports[`get.package.format given: [case10] an installed esm-only package when: [t0] it is measured then: the readout matches its snapshot: stdout-direct-spawn-no-runner-frame 1`] = `
"🧮 get.package.format --package fixture-esm-only
   ├─ version: 1.0.0
   ├─ manifest
   │  ├─ type: module
   │  ├─ main: (absent)
   │  └─ exports['.'].require: (absent)
   ├─ probe (node vNODE — this runtime only)
   │  └─ require(): ✗ refuses
   │     └─ No "exports" main defined in /TMP_TEST_DIR/node_modules/fixture-esm-only/package.json
   └─ verdict: esm-only

   🟡 esm-only — a static import compiles to require() in dist and a cjs consumer
      cannot load it. route it through getOneLazyEsmModuleLoader
      (\`rule.forbid.eager-esm-imports-in-prod\`).

"
`;
