exports[`keyrack status: sso renew given: [case1] an sso key held by the daemon, through renew, halt, cure, lapse when: [t1] the renew faults every tick then: status --json matches snapshot 1`] = `
[
  {
    "env": "test",
    "expiresAt": "__REDACTED__",
    "org": "testorg",
    "renew": {
      "mark": {
        "error": "💥 MalfunctionError: aws configure export-credentials failed with unexpected error

{
  "profileName": "testorg-test",
  "hint": "read the cli stderr in the cause below; to see it outside keyrack: aws configure export-credentials --profile testorg-test",
  "error": {
    "code": 1,
    "killed": false,
    "signal": null,
    "cmd": "aws configure export-credentials --profile testorg-test --format env-no-export",
    "stdout": "",
    "stderr": "mock aws: connection reset by peer\\n"
  }
}",
        "kind": "halted",
      },
      "renewedCount": "__N__",
    },
    "slug": "testorg.test.AWS_PROFILE",
    "ttlLeftMs": "__REDACTED__",
  },
]
`;

exports[`keyrack status: sso renew given: [case1] an sso key held by the daemon, through renew, halt, cure, lapse when: [t1] the renew faults every tick then: status stdout matches snapshot 1`] = `
"
🔐 keyrack status
   ├─ owner: (default)
   ├─ recipients:
   │  └─ default (age)
   ├─ daemon: active ✨
   └─ testorg.test.AWS_PROFILE
      ├─ env: test
      ├─ org: testorg
      ├─ expires in: __6-15__m
      ├─ renewed = __N__x
      └─ halted
         ├─ renew stopped on a fault it could not clear
         ├─ 💥 MalfunctionError: aws configure export-credentials failed with unexpected error
         │  └─ full error
         │     └─ rhx keyrack status --env test --json
         └─ fix
            ├─ rhx keyrack unlock --env test
            │  ├─ once the fault above clears
            │  └─ if the sso session ended meanwhile, a human must finish the browser login
            └─ rhx keyrack daemon prune
               ├─ if the fault lives in the daemon's own env
               ├─ drops every key the daemon holds; a key kept only in the daemon will not come back
               └─ then unlock again

"
`;

exports[`keyrack status: sso renew given: [case1] an sso key held by the daemon, through renew, halt, cure, lapse when: [t2] the human runs the rendered fix once the fault clears then: the cure unlock stdout matches snapshot 1`] = `
"
🔓 keyrack unlock
   └─ testorg.test.AWS_PROFILE
      ├─ env: test
      ├─ org: testorg
      ├─ vault: aws.config
      └─ expires in: __6-15__m

"
`;

