// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`keyrack org-mismatch given: [case1] get with org mismatch when: [t0] get --key API_KEY --org foreign-org then: the human-seen refusal matches snapshot 1`] = `
"
🔐 keyrack get
   └─ ✋ ConstraintError: --org 'foreign-org' is not on this manifest's org allowlist
      ├─ org
      │  ├─ given: foreign-org
      │  └─ avail: testorg
      ├─ ran: keyrack get --key API_KEY --env test --org foreign-org
      └─ hint:
         ├─ use one of 'testorg'
         ├─ or add 'foreign-org' to org: in .agent/keyrack.yml
         └─ or, for a key that belongs to no org, use --org @all

"
`;

exports[`keyrack org-mismatch given: [case2] set with org mismatch when: [t0] set --key AWS_PROFILE --org foreign-org --json then: the human-seen refusal matches snapshot 1`] = `
"
🔐 keyrack set
   └─ ✋ ConstraintError: --org 'foreign-org' is not on this manifest's org allowlist
      ├─ org
      │  ├─ given: foreign-org
      │  └─ avail: testorg
      ├─ ran: keyrack set --key AWS_PROFILE --env prep --org foreign-org --mech PERMANENT_VIA_REPLICA --vault os.direct --json
      └─ hint:
         ├─ use one of 'testorg'
         ├─ or add 'foreign-org' to org: in .agent/keyrack.yml
         └─ or, for a key that belongs to no org, use --org @all

"
`;

exports[`keyrack org-mismatch given: [case2] set with org mismatch when: [t1] set --key AWS_PROFILE --org @this (valid match) then: stdout matches snapshot 1`] = `
{
  "createdAt": "__TIMESTAMP__",
  "env": "prod",
  "exid": null,
  "maxDuration": null,
  "mech": "PERMANENT_VIA_REPLICA",
  "meta": null,
  "org": "testorg",
  "slug": "testorg.prod.AWS_PROFILE",
  "updatedAt": "__TIMESTAMP__",
  "vault": "os.direct",
}
`;

exports[`keyrack org-mismatch given: [case3] a full slug that clashes on BOTH org and env when: [t0] set is given that slug with a clashing --env then: the human-seen refusal matches snapshot 1`] = `
"
🔐 keyrack set
   └─ ✋ ConstraintError: slug org 'foreign-org' is not on this manifest's org allowlist
      ├─ key: foreign-org.prod.AWS_PROFILE
      ├─ org
      │  ├─ given: foreign-org
      │  └─ avail: testorg
      ├─ ran: keyrack set --key foreign-org.prod.AWS_PROFILE --env test --mech PERMANENT_VIA_REPLICA --vault os.direct
      └─ hint:
         ├─ use one of 'testorg'
         └─ or add 'foreign-org' to org: in .agent/keyrack.yml

"
`;

exports[`keyrack org-mismatch given: [case3] a full slug that clashes on BOTH org and env when: [t1] del is given the same slug with the same clashing --env then: the human-seen refusal matches snapshot 1`] = `
"
🔐 keyrack del
   └─ ✋ ConstraintError: slug org 'foreign-org' is not on this manifest's org allowlist
      ├─ key: foreign-org.prod.AWS_PROFILE
      ├─ org
      │  ├─ given: foreign-org
      │  └─ avail: testorg
