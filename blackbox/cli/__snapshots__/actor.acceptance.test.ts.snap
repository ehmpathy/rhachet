exports[`rhx actor list (acceptance) given: [case1] a linked repo with NO actors enrolled when: [t0] \`actor list\` on the empty repo then: the empty-state format is locked (visual spot-check) 1`] = `
"🎭 actors
   └─ (no actors enrolled yet)
      └─ enroll one with \`rhx enroll <brain>\`
"
`;

exports[`rhx actor list (acceptance) given: [case1] a linked repo with NO actors enrolled when: [t1] \`actor list --output json\` on the empty repo then: the empty-actors json shape is locked (catches a drifted shape) 1`] = `
"{
  "actors": []
}
"
`;

exports[`rhx actor list (acceptance) given: [case2] a linked repo with ONE actor enrolled when: [t0] \`actor list\` after an enroll then: the populated-actor format is locked (visual spot-check) 1`] = `
