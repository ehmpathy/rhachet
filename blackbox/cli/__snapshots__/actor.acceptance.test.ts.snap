exports[`rhx actor list (acceptance) given: [case5] a corrupt actor manifest on disk (server fault) when: [t0] \`actor list\` on the corrupt repo (tree) then: the corrupt-manifest tree error is locked to a snapshot 1`] = `
"
💥 MalfunctionError: enrolled actor manifest is corrupt — actor.json is not valid JSON

{
  "manifestPath": "/TMP_TEST_DIR/.agent/.actors/actor.via.hash=deadbeefdeadbeef/actor.json",
  "exid": "hash=deadbeefdeadbeef",
  "cause": {
    "class": "SyntaxError",
    "message": "Expected property name or '}' in JSON at position 2 (line 1 column 3)"
  }
}

[args] actor,list

"
`;

