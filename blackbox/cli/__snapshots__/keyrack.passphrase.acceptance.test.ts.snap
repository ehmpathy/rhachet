exports[`keyrack passphrased-ed25519 unlock (Variant A) given: [case10] passphrased FIDO/sk- key, explicit --prikey fails fast when: [t0] unlock runs with an explicit FIDO --prikey then: the error names the FIDO limit + the swap-key fix, not a generic miss: fido-unsupported 1`] = `
"🔐 unlock robot identity · ephemeral agent, zero reuse (fresh prompt each unlock — by design)
🔐 unlock code: __CODE__   (confirm this matches the dialog before you type)

✋ ConstraintError: 🔐 passphrase-protected FIDO/hardware-token key (sk-ssh-ed25519@openssh.com) — not supported for keyrack unlock in v1.
   ├─ why: its private half stays on the security key, so it cannot back the
   │       ssh-agent unlock
   └─ fix: init the keyrack with a key keyrack can unlock — an ed25519 key
           (passphrased is fine — the native dialog unlocks it), or a
           passphrase-less key. then retry:
           rhx keyrack init --prikey <path-to-that-key>

{
  "owner": "robot",
  "prescribed": [
    "/TMP_REPO/custom-keys/id_ed25519_sk"
  ]
}

[args] keyrack,unlock,--owner,robot,--prikey,/TMP_REPO/custom-keys/id_ed25519_sk,--env,sudo,--key,testorg.sudo.ANY_KEY

"
`;

exports[`keyrack passphrased-ed25519 unlock (Variant A) given: [case13] keyrack unlock --help documents the KEYRACK_ASKPASS seam when: [t0] the human asks for unlock help then: the help output stays pinned (contract-grain snapshot): unlock-help 1`] = `
"Usage: rhachet keyrack unlock [options]

unlock keys and send them to daemon for session access

Options:
  --owner <owner>        owner identity (e.g., mechanic, foreman)
  --for <owner>          alias for --owner
  --env <env>            target env: prod, prep, test, all, or sudo
  --key <key>            specific key to unlock (required for --env sudo)
  --duration <duration>  TTL for unlocked keys (default: 30m for sudo, 9h for
                         others)
  --prikey <path>        explicit ssh private key path (fallback when discovery
                         fails)
  --json                 output as json (robot mode)
  -h, --help             display help for command

env:
  KEYRACK_ASKPASS   absolute path to a gnome-compatible ssh-askpass dialog.
                    keyrack auto-detects ssh-askpass-gnome by default; set this
                    to override that when your dialog lives elsewhere, or on a
                    non-gnome desktop. the passphrase is typed into this dialog,
                    never the terminal (keylogger mitigation).
"
`;
