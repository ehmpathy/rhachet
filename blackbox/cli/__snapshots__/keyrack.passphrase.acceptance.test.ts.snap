exports[`keyrack passphrased-ed25519 unlock (Variant A) given: [case3] a second ed25519 key signs, but it is the wrong key when: [t0] unlock runs with the wrong ed25519 key then: the error names the wrong-key fix, not a bare unwrap failure: wrong-key 1`] = `
"🔐 unlock robot identity · ephemeral agent, zero reuse (fresh prompt each unlock — by design)
🔐 unlock code: __CODE__   (confirm this matches the dialog before you type)

✋ ConstraintError: cannot unlock this keyrack manifest — no identity could decrypt it.
   ├─ fix: make its ssh key available, or name it with --prikey <path>
   └─ or:  if sealed to a passphrased key's pubkey recipient, --prikey cannot help —
           re-init instead (re-adds its credentials): rm /TMP_REPO/.rhachet/keyrack/keyrack.host.robot.age && rhx keyrack init

{
  "path": "/TMP_REPO/.rhachet/keyrack/keyrack.host.robot.age",
  "owner": "robot",
  "identities": {
    "available": [
      "/TMP_REPO/custom-keys/other_key",
      "AGE-SECRET-KEY-<redacted>"
    ],
    "attempted": [
      "/TMP_REPO/custom-keys/other_key",
      "AGE-SECRET-KEY-<redacted>"
    ]
  },
  "note": "if this key unlocked before, an openssh upgrade may have changed its signature serialization (a known cross-version risk)"
}

[args] keyrack,unlock,--owner,robot,--prikey,/TMP_REPO/custom-keys/other_key,--env,sudo,--key,testorg.sudo.ANY_KEY

"
`;

exports[`keyrack passphrased-ed25519 unlock (Variant A) given: [case4] passphrased key, headless session (no DISPLAY, no dialog) when: [t0] init runs headless with a passphrased key then: the error names the no-display cause + the fixes, distinctly: headless 1`] = `
"🔐 initialize robot identity
🔐 unlock code: __CODE__   (confirm this matches the dialog before you type)

✋ ConstraintError: this keyrack manifest needs a graphical passphrase dialog, but this session has no display
   ├─ why: your ssh key has a passphrase, so unlock pops a desktop dialog to
   │       enter it — and this looks like a headless session (ci, or ssh with
   │       no display), where no dialog can appear
   └─ fix: run this on your local desktop session, or use a passphrase-less key —
           e.g. rhx keyrack unlock --owner robot --prikey ~/.ssh/id_ed25519

{
  "keyPath": "/TMP_REPO/custom-keys/passphrased_key"
}

[args] keyrack,init,--owner,robot,--prikey,/TMP_REPO/custom-keys/passphrased_key

"
`;

exports[`keyrack passphrased-ed25519 unlock (Variant A) given: [case5] KEYRACK_ASKPASS names an absent dialog (blackbox, hermetic) when: [t0] init runs with an absent askpass override then: the error names the override path + the fix, not a host dialog: askpass-absent 1`] = `
"🔐 initialize robot identity
🔐 unlock code: __CODE__   (confirm this matches the dialog before you type)

✋ ConstraintError: KEYRACK_ASKPASS points at a passphrase dialog that does not exist
   ├─ set to: /TMP_REPO/no-such-dialog
   ├─ why: KEYRACK_ASKPASS overrides dialog auto-detection, so keyrack uses
   │       only that path — and nothing is there
   └─ fix: point KEYRACK_ASKPASS at a real askpass dialog, or unset it to
           auto-detect ssh-askpass-gnome

{
  "override": "/TMP_REPO/no-such-dialog",
  "fix": "point KEYRACK_ASKPASS at a present askpass dialog, or unset it to auto-detect ssh-askpass-gnome"
}

[args] keyrack,init,--owner,robot,--prikey,/TMP_REPO/custom-keys/passphrased_key

"
`;

