exports[`rhx actor/clone --help (acceptance) given: [case1] a repo where the commands are registered when: [t5] clone get --help then: the help text is locked (visual spot-check) 1`] = `
"Usage: rhachet clone get [options] <address>

observe a clone's recent output (by @:<slug|serial>)

Options:
  --tail <n>       how many recent messages to show (or all) (default: "20")
  --format <fmt>   tree render: blocks (default, directioned) or raw (verbatim
                   replies) (default: "blocks")
  --output <mode>  output mode: tree (default) or json (default: "tree")
  -h, --help       display help for command
"
`;

