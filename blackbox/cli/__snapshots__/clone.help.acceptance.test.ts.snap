exports[`rhx actor/clone --help (acceptance) given: [case1] a repo where the commands are registered when: [t2] clone --help then: the help text is locked (visual spot-check) 1`] = `
"Usage: rhachet clone [options] [command]

reach an enrolled clone: list, say, get, whoami, prune

Options:
  -h, --help               display help for command

Commands:
  list [options] [actor]   list clones (all, or scoped to one actor by
                           @<hash-prefix>)
  say [options] <address>  dispatch a message into a live clone (by
                           @:<slug|serial>)
  get [options] <address>  observe a clone's recent output (by @:<slug|serial>)
  whoami [options]         show THIS clone's own address (run from within a
                           clone)
  prune [options] [actor]  reap dead clones (all, or scoped to one actor by
                           @<hash-prefix>)
  help [command]           display help for command
"
`;

