exports[`rhx actor/clone --help (acceptance) given: [case1] a repo where the commands are registered when: [t7] clone prune --help then: the help text is locked (visual spot-check) 1`] = `
"Usage: rhachet clone prune [options] [actor]

reap dead clones (all, or scoped to one actor by @<hash-prefix>)

Options:
  --older-than <dur>  only reap clones spawned at least this long ago (e.g. 1h,
                      30m); measures age since spawn, not since death (a clone
                      has no recorded death time)
  --mode <mode>       plan (default, preview) or apply (remove) (default:
                      "plan")
  --output <mode>     output mode: tree (default) or json (default: "tree")
  -h, --help          display help for command
"
`;
