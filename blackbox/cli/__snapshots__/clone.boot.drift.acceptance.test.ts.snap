exports[`rhx clone boot drift (acceptance) given: [case2] a clone whose boot drifted past the threshold when: [t1] the onStop hook runs inside the clone, twice then: the notice matches snapshot 1`] = `
"😶 boot drift of @:reviewer
   ├─ 1 block drifted since this clone spawned (1 added)
   ├─ 252 lines of drift, over the 200 line threshold
   └─ to take it
      ├─ /compact — the clone reads the drift in, its conversation kept
      │  ├─ type it in this session, or send it: rhx clone say @:reviewer --what /compact
      │  └─ after it, the clone holds drift = 713459dc785f201a
      └─ respawn — the new boot loads whole, from the shared cache; the sure cure"
`;

exports[`rhx clone boot drift (acceptance) given: [case3] a clone whose boot drifted past the 2000 line carry cap when: [t0] \`clone boot drift --of @:capped\` runs then: the tree matches snapshot 1`] = `
"😶 boot drift of @:capped
   ├─ spawn boot = 2daaf0558332428b
   ├─ drift = e34cf10635b25858
   ├─ 1 block drifted since this clone spawned (1 added)
   ├─ 2512 lines of drift, over the 200 line threshold
   └─ past the 2000 line cap, the drift carries no block, so a compaction takes naught; only a respawn takes the current boot
"
`;

