exports[`rhx clone boot drift (acceptance) given: [case1] a repo with no clone enrolled when: [t0] the readout runs outside a clone, with no --of then: the error matches snapshot 1`] = `
"
✋ ConstraintError: no clone is named, and this process runs in none

{
  "hint": "name one with \`--of @:<slug|serial>\`; list clones with \`rhx clone list\`"
}

[args] clone,boot,drift

"
`;

exports[`rhx clone boot drift (acceptance) given: [case1] a repo with no clone enrolled when: [t1] the readout names a clone that does not exist then: the error matches snapshot 1`] = `
"
✋ ConstraintError: no clone answers to that address

{
  "hint": "list clones with \`rhx clone list\`",
  "address": "@:ghost"
}

[args] clone,boot,drift,--of,@:ghost

"
`;

exports[`rhx clone boot drift (acceptance) given: [case1] a repo with no clone enrolled when: [t1b] the readout names a clone without the @: clone marker then: the error matches snapshot 1`] = `
"
✋ ConstraintError: 'driver' is not a clone address; clone addresses start with '@:'. did you mean '@:driver'?

{
  "hint": "use '@:driver'",
  "raw": "driver"
}

[args] clone,boot,drift,--of,driver

"
`;

exports[`rhx clone boot drift (acceptance) given: [case1] a repo with no clone enrolled when: [t3] the onStop hook runs with a serial no clone on disk holds then: the error matches snapshot 1`] = `
"
💥 MalfunctionError: the clone env serial names no on-disk clone

{
  "hint": "the clone record is gone; respawn the clone with \`rhx enroll\`, or list clones with \`rhx clone list\`",
  "serial": "__SERIAL__"
}

[args] clone,boot,drift,--when,hook.onStop

"
`;

exports[`rhx clone boot drift (acceptance) given: [case1] a repo with no clone enrolled when: [t4] the hook moment rides --of then: the error matches snapshot 1`] = `
"
✋ ConstraintError: --of cannot ride --when hook.onStop

{
  "hint": "the hook reads the clone it runs in; to inspect another clone, drop --when: rhx clone boot drift --of @:ghost"
}

[args] clone,boot,drift,--when,hook.onStop,--of,@:ghost

"
`;

