exports[`rhx clone boot drift (acceptance) given: [case2] a clone whose boot drifted past the threshold when: [t0] \`clone boot drift --of @:reviewer\` runs then: the tree matches snapshot 1`] = `
"😶 boot drift of @:reviewer
   ├─ spawn boot = 2daaf0558332428b
   ├─ drift = 713459dc785f201a
   ├─ 1 block drifted since this clone spawned (1 added)
   ├─ 252 lines of drift, over the 200 line threshold
   ├─ the clone reads the drift in at its next compaction
   ├─ to take it now
   │  └─ rhx clone say @:reviewer --what /compact
   └─ after a compaction it holds drift = 713459dc785f201a; if it does not, respawn it
"
`;

