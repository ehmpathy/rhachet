exports[`keyrack machine-wide skips manifest given: [case3] a cwd that is not a git repo at all when: [t1] a REPO-scoped set is asked — THE CRASH GUARD then: the render a human sees is snapped 1`] = `
"
🔐 keyrack set
   └─ ✋ ConstraintError: this keyrack ask names a repo key, but the cwd is not a git repo
      ├─ why: a repo key is declared by the repo keyrack.yml, so it can be named only from inside that repo
      ├─ cwd: $TESTCWD
      ├─ ran: keyrack set --key FOO --env test --at .agent/keyrack.yml --mech PERMANENT_VIA_REPLICA --vault os.direct
      └─ hint: run from inside the repo, or name a machine-wide key with --org @all (it needs no repo at all)

"
`;

exports[`keyrack machine-wide skips manifest given: [case3] a cwd that is not a git repo at all when: [t2] a MACHINE-WIDE set is asked with --at — the contradiction then: the render a human sees is snapped 1`] = `
"
🔐 keyrack set
   └─ ✋ ConstraintError: --at and a machine-wide key are contradictory
      ├─ why: a machine-wide key is declared in the host manifest, so it consults no repo keyrack.yml — and --at names one to consult
      ├─ ran: keyrack set --key FOO --env camp --org @all --at .agent/keyrack.yml --mech PERMANENT_VIA_REPLICA --vault os.direct
      └─ hint: drop --at to set the machine-wide key, or name a repo key instead (drop --org @all, and use a bare key name rather than an @all.<env>.<name> slug)

"
`;

exports[`keyrack machine-wide skips manifest given: [case3] a cwd that is not a git repo at all when: [t3] the OTHER three sweep verbs are asked by --org @this then: the render each human sees is snapped 1`] = `
{
  "source": "
🔐 keyrack source
   └─ ✋ ConstraintError: no keyrack.yml found in repo. --for repo requires keyrack.yml
      ├─ ran: keyrack source --env test --org @this
      └─ hint: run: rhx keyrack init --org <your-org>

",
  "status": "
🔐 keyrack status
   └─ ✋ ConstraintError: --org @this names this repo, but no repo keyrack.yml was found
      ├─ why: @this expands to the org declared in .agent/keyrack.yml, and there is none to read
      ├─ ran: keyrack status --org @this
      └─ hint: run: rhx keyrack init --org <your-org> (or filter by --org @all for machine-wide keys)

",
  "unlock": "
🔐 keyrack unlock
   └─ ✋ ConstraintError: --org @this names this repo, but no repo keyrack.yml was found
      ├─ why: @this expands to the org declared in .agent/keyrack.yml, and there is none to read
      ├─ ran: keyrack unlock --env test --org @this
      └─ hint: run: rhx keyrack init --org <your-org> (or filter by --org @all for machine-wide keys)

",
}
`;

