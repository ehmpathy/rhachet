exports[`keyrack machine-wide skips manifest given: [case2] a HEALTHY repo whose rack holds both provenances when: [t5] a repo sweep is filtered to --org @all then: the note a human reads is snapped 1`] = `
"
💡 heads up — a repo sweep holds no machine-wide keys
   ├─ why: a repo keyrack.yml declares keys under its OWN org, so a sweep of it
   │       can never yield an \`@all.*\` key — the filter is empty by construction
   └─ fix: name the key outright, which needs no repo keyrack at all —
           rhx keyrack source --key @all.test.<name>

"
`;

