    {
      "email": "a@example.com",
      "account": null,
      "status": "unverified",
      "windows": [],
      "savedResets": null,
      "signedIn": true,
      "renewed": false
    }
  ]
}
"
`;

exports[`brains auth given: [case6] a home signed in on a login whose access token lapsed when: [t2] \`brains auth use --scope grove\` over the lapsed login then: the refusal matches its snapshot 1`] = `
"
✋ ConstraintError: the grove's signed-in account is unverified

{
  "hint": "run any claude session on this box once; it renews the login. then retry",
  "signedIn": "a@example.com",
  "why": "its live access token has lapsed, and a refresh would end the session it serves"
}

[args] brains,auth,use,--account,b@example.com,--scope,grove

"
`;

