exports[`brains auth given: [case4] the help a caller reads to find each verb and its flags when: [t0] \`brains --help\` then: the help matches its snapshot 1`] = `
"Usage: rhachet brains [options] [command]

manage brain credentials — auth set, get, use

Options:
  -h, --help      display help for command

Commands:
  auth            brain account logins — set, get, use
  help [command]  display help for command
"
`;

exports[`brains auth given: [case4] the help a caller reads to find each verb and its flags when: [t1] \`brains auth --help\` then: the help matches its snapshot 1`] = `
"Usage: rhachet brains auth [options] [command]

brain account logins — set, get, use

Options:
  -h, --help      display help for command

Commands:
  set [options]   log into a brain account and store it in the keyrack
  get [options]   show each brain account and its usage windows; the read renews
                  each stored login, since a refresh token is single use
  use [options]   put a stored brain account to use at a scope
  help [command]  display help for command
"
`;

exports[`brains auth given: [case4] the help a caller reads to find each verb and its flags when: [t2] \`brains auth set --help\` then: the help matches its snapshot 1`] = `
"Usage: rhachet brains auth set [options]

log into a brain account and store it in the keyrack

Options:
  --brain <slug>     the brain whose account to log into (default: "claude")
  --owner <owner>    keyrack owner that holds the accounts (default: "ehmpath")
  --output <mode>    output mode — tree or json (default: "tree")
  --account <email>  the account to log in as; a login of any other is refused
  -h, --help         display help for command

examples
  rhx brains auth set                              # log in at a browser; the login files into the keyrack
  rhx brains auth set --account b@example.com      # refuse a login of any other account
"
`;

exports[`brains auth given: [case4] the help a caller reads to find each verb and its flags when: [t3] \`brains auth get --help\` then: the help matches its snapshot 1`] = `
"Usage: rhachet brains auth get [options]

show each brain account and its usage windows; the read renews each stored
login, since a refresh token is single use

Options:
  --brain <slug>     the brain whose account to read (default: "claude")
  --owner <owner>    keyrack owner that holds the accounts (default: "ehmpath")
  --output <mode>    output mode — tree or json (default: "tree")
  --account <email>  one stored account to read, or @all for every one (default:
                     "@all")
  -h, --help         display help for command

examples
  rhx brains auth get                             # every account, as a table
  rhx brains auth get --account a@example.com     # one account; rotates its stored login
  rhx brains auth get --output json               # for a machine to parse

each read rotates the stored login of each account it reads, and parks the new one back.
poll no faster than once per 5 minutes, since each read writes the keyrack
"
`;

exports[`brains auth given: [case4] the help a caller reads to find each verb and its flags when: [t4] \`brains auth use --help\` then: the help matches its snapshot 1`] = `
"Usage: rhachet brains auth use [options]

put a stored brain account to use at a scope

Options:
  --brain <slug>     the brain whose account to use (default: "claude")
  --owner <owner>    keyrack owner that holds the accounts (default: "ehmpath")
  --output <mode>    output mode — tree or json (default: "tree")
  --account <email>  the stored account to use (required)
  --scope <scope>    where to use it, required — grove, the login every clone on
                     this box reads (clone and tree to come)
  -h, --help         display help for command

examples
  rhx brains auth use --account b@example.com --scope grove                  # swap the box login to b
  rhx brains auth use --account b@example.com --scope grove --output json    # for a machine to parse
"
`;

