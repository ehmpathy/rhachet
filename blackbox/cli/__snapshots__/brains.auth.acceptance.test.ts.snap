exports[`brains auth given: [case6] a home signed in on a login whose access token lapsed when: [t0] \`brains auth get\` then: the tree matches its snapshot 1`] = `
"🧠 brains auth get
   ├─ owner = ehmpath
   └─ a@example.com (signed in)
      └─ unverified — the signed-in token lapsed, and a read never refreshes it; any claude session renews it
"
`;

exports[`brains auth given: [case6] a home signed in on a login whose access token lapsed when: [t1] \`brains auth get --output json\` then: the raw json matches its snapshot 1`] = `
