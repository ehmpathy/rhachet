exports[`rhx given: [case5] rhx init bare-sigil alias when: [t5] \`rhx init --help\` (x6 help not mistaken for sigil) then: the alias --help output matches snapshot 1`] = `
"Usage: rhachet init [options]

initialize roles from packages or generate rhachet.use.ts

Options:
  --roles <roles...>   role specifiers: bare names replace the set (mechanic
                       behaver), or +role to add / -role to remove incrementally
  --hooks [brains...]  apply brain hooks (auto-detect brains if no args)
  --config             generate rhachet.use.ts config (legacy behavior)
  --prep               persist init command to package.json prepare entries
  --mode <mode>        findsert preserves prior, upsert overwrites (default:
                       "findsert")
  --keys               initialize keyrack manifest (requires --roles)
  -h, --help           display help for command
"
`;

exports[`rhx given: [case5] rhx init bare-sigil alias when: [t6] \`rhx init +nonesuch\` (x7 unknown-role error path) then: the alias error block matches snapshot 1`] = `
"
BadRequestError: role "nonesuch" not found

{
  "specifier": "nonesuch",
  "availableRoles": [ "$AVAILABLE_ROLES" ]
}

[args] init,--keys,--hooks,--roles,+nonesuch

"
`;
