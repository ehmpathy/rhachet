exports[`rhx given: [case5] rhx init bare-sigil alias when: [t0] \`rhx init +architect\` (x1 fresh bare add) then: the alias success-path summary matches snapshot 1`] = `
"🔧 init roles (incremental)
   ├─ additions
   │  └─ + ehmpathy/architect
   └─ untouched (0)

📚 link role repo=ehmpathy/role=architect
   ├─ links
   │  ├─ + .agent/readme.md
   │  ├─ + .agent/repo=.this/readme.md
   │  ├─ + .agent/repo=ehmpathy/readme.md
   │  ├─ + .agent/repo=ehmpathy/.gitignore
   │  ├─ + .agent/repo=ehmpathy/role=architect/readme.md
   │  ├─ + .agent/repo=ehmpathy/role=architect/boot.yml
   │  └─ + .agent/repo=ehmpathy/role=architect/briefs
   └─ stats
      └─ 36 brief(s)

🔑 keyrack init
   ├─ org: ehmpathy
   └─ created .agent/keyrack.yml

🔭 search for linked roles with hooks...
   └─ ehmpathy/architect

🪝 apply hooks to brains...

✨ hooks: no changes needed

"
`;

exports[`rhx given: [case5] rhx init bare-sigil alias when: [t2] \`rhx init -ergonomist\` (x3 remove bare sigil) then: the alias remove-path summary matches snapshot 1`] = `
"🔧 init roles (incremental)
   ├─ subtractions
   │  └─ - ehmpathy/ergonomist
   └─ untouched (1)

🔭 search for linked roles with hooks...
   └─ ehmpathy/architect

