exports[`hook dispatcher (one process per claude event) given: [case1] a repo whose role declares hook rules of every kind when: [t13] the manifest is of a version this dispatcher does not read then: the refusal matches the snapshot 1`] = `
"✋ ConstraintError: hook dispatch manifest version is not one this dispatcher reads
   ├─ manifest = .claude/version-skew.manifest
   ├─ header = # rhachet hooks.dispatch manifest v2 — written by \`rhx init --hooks\`
   ├─ reads = v1
   └─ fix = run \`npx rhx init --hooks\`, with the rhachet this repo installs, to rewrite it
"
`;
