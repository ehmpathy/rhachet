exports[`rhx init under .agent/actors.yml (acceptance) given: [case2] a role linked by hand, then a manifest that omits it when: [t0] \`init\` with no --roles then: the report block holds its shape 1`] = `
"🎭 actors.yml
   ├─ repo actor = @solo
   ├─ 1 actor(s), 1 role(s) declared
   ├─ in sync, no role short
   └─ extra → kept, undeclared
      └─ ehmpathy/architect
         ├─ to keep it, declare \`ehmpathy/architect\` in .agent/actors.yml
         └─ to drop it, unlink .agent/repo=ehmpathy/role=architect"
`;

exports[`rhx init under .agent/actors.yml (acceptance) given: [case3] \`--roles\` beside a manifest when: [t0] \`init --roles mechanic\` then: the refusal holds its shape 1`] = `
