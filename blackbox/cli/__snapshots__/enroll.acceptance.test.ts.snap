exports[`rhx enroll --help (acceptance) given: [case1] a bare \`enroll --help\` with NO brain when: [t0] the human asks for help without a brain then: the help format is locked (visual spot-check) 1`] = `
"Usage: rhachet enroll [options] [brain]

enroll a brain cli as a managed, addressable clone

Options:
  --brain <brain>     the brain to enroll (alias of the positional)
  -r, --roles <spec>  roles to enroll — a single spec (e.g. mechanic,
                      +architect, -driver). for multiple use the comma form
                      (--roles -driver,-reviewer) or quote the space form
                      (--roles "-driver -reviewer"). a bare delta is an alias
                      (rhx enroll claude -driver ≡ --roles -driver).
                      role::<subject> boots one subject of the role, with all
                      its hooks (mechanic::flow, +mechanic::flow); list subjects
                      via npx rhachet roles cost --all
  --as <address>      name the clone with a stable handle (@:<slug>)
  --no-socket         enroll without a managed reach socket
  --reason <text>     why this enrollment happened (or @stdin)
  --watch             hold the clone in the foreground (default at a terminal)
  --async             report the clone address and exit (default with no
                      terminal)
  --await             hold until the clone answers its prompt and exits, then
                      forward its exit code (default with a prompt, e.g. -p
                      "<prompt>"). a -p clone is a leaf: it may enroll no clone
                      of its own
  --output <mode>     output mode: tree (default) or json (default: "tree")
"
`;

