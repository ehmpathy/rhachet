exports[`invokeClone (integration) given: [case18] a drifted clone whose drift on disk lags the current boot when: [t0] \`clone boot drift --of @:stale\` runs then: the error matches snapshot, its repo path masked 1`] = `
"
💥 MalfunctionError: the boot drift on disk is stale: the last render did not reach it

{
  "hint": "run \`rhx init\` to re-write every drift; if a render is in flight, re-run this once it ends",
  "path": "<repo>/.agent/.actors/actor.via.hash=8967acd9/boots/serial=<serial>/CLAUDE.md"
}

[args] clone,boot,drift,--of,@:stale

"
`;
