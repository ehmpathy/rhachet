exports[`getProbeHoldMs given: [case2] a malformed hold was handed when: [t0] a probe asks for it then: it refuses as a ConstraintError that names the env var and the fix 1`] = `
"✋ ConstraintError: a tempdir-clamp probe was handed a hold that is not a count of ms

