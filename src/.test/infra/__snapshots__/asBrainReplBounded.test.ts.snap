exports[`asBrainReplBounded given: [case2] a repl that hangs past the bound, with no api key in its env when: [t0] ask is called then: it says the repl gave no answer, and names a rate limit 1`] = `
"💥 MalfunctionError: the repl brain gave no answer in 1s

{
  "brain": "fake/repl/slow",
  "why": "a vendor refusal (rate limit, no credit, a dead oauth token) hangs the repl rather than throws",
  "auth": "no api key in the test env, so the repl used the box login",
  "hint": "run \`rhx claude.vendor.probe --via login\` to see the vendor text on that login, fix the cause, then re-run the suite"
}"
`;

exports[`asBrainReplBounded given: [case3] a repl that hangs past the bound, with an api key in its env when: [t0] ask is called then: it names the api key it billed 1`] = `
