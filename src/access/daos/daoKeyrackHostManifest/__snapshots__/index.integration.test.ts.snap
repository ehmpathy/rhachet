// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`daoKeyrackHostManifest given: [case13] legacy manifest sealed to a raw ssh recipient (v0) when: [t0] get called and no identity can decrypt it then: throws an actionable re-init upgrade error, not the generic hint: legacy-ssh-reinit-message 1`] = `
"✋ ConstraintError: 🔐 this keyrack was sealed with an older format the native-dialog unlock cannot open in-process.
to upgrade it to the ssh-agent unlock, re-initialize the manifest (you will re-add its credentials):
   ├─ remove the old manifest: rm <HOME>/.rhachet/keyrack/keyrack.host.legacyssh.age
   └─ re-initialize:           rhx keyrack init

{
  "path": "<HOME>/.rhachet/keyrack/keyrack.host.legacyssh.age",
  "owner": "legacyssh"
}"
`;

exports[`daoKeyrackHostManifest given: [case15] manifest sealed to a pubkey-age1 recipient, no identity when: [t0] get called and no identity can decrypt it then: names re-init as a fix, not the --prikey-only misdirect: pubkey-age1-reinit-message 1`] = `
"✋ ConstraintError: cannot unlock this keyrack manifest — no identity could decrypt it.
   ├─ fix: make its ssh key available, or name it with --prikey <path>
   └─ or:  if sealed to a passphrased key's pubkey recipient, --prikey cannot help —
           re-init instead (re-adds its credentials): rm <HOME>/.rhachet/keyrack/keyrack.host.age1niche.age && rhx keyrack init

{
  "path": "<HOME>/.rhachet/keyrack/keyrack.host.age1niche.age",
  "owner": "age1niche",
  "identities": {
    "available": [],
    "attempted": []
  },
  "note": "if this key unlocked before, an openssh upgrade may have changed its signature serialization (a known cross-version risk)"
}"
`;
