exports[`sshPrikeyToAgeIdentity.integration given: [case1] a passphrase-protected ed25519 key when: [t0] age CLI is available on PATH then: sshPrikeyToAgeIdentity returns SSH_KEY_PATH_MARKER with absolute path 1`] = `"SSH_KEY_PATH:<masked-path>"`;

exports[`sshPrikeyToAgeIdentity.integration given: [case1] a passphrase-protected ed25519 key when: [t1] age CLI is NOT on PATH then: error message matches snapshot 1`] = `
"✋ ConstraintError: 🔐 your ssh key is passphrase-protected (cipher: aes256-ctr).
keyrack uses the \`age\` cli to decrypt via ssh-agent — no passphrase prompt needed.

install age:
  ├─ brew install age          # macos
  └─ apt install age           # ubuntu/debian

then retry: rhx keyrack init

note: passphrase-less keys (-N "") do not need age installed.

{
  "cipher": "aes256-ctr",
  "keyPath": "<redacted>"
}"
`;
