// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`parseRoleBootYaml given: [case15] a subject that declares its \`always\` inheritance when: [t1] the inherit key is misspelled then: it throws, and names the key it read and the one it wanted 1`] = `
"✋ ConstraintError: boot.yml declares an \`always\` inheritance under a key no render reads — as written, the subject still boots \`always\`

{
  "path": "boot.yml",
  "section": "subject.101",
  "key": "inhert",
  "expected": "inherit",
  "hint": "rename \`inhert\` to \`inherit\` in boot.yml; if the role is a package you do not own, report it to that package, and enroll without this role (\`--roles -<role>\`) until its fix ships — every boot of the role reads this file"
}"
`;

exports[`parseRoleBootYaml given: [case15] a subject that declares its \`always\` inheritance when: [t2] the inner always key is misspelled then: it throws rather than inherit in silence 1`] = `
"✋ ConstraintError: boot.yml has invalid schema for subject mode

{
  "path": "boot.yml",
  "errors": [
    {
      "expected": "boolean",
      "code": "invalid_type",
      "path": [
        "subject.101",
        "inherit",
        "always"
      ],
      "message": "Invalid input: expected boolean, received undefined"
    },
    {
      "code": "unrecognized_keys",
      "keys": [
        "allways"
      ],
      "path": [
        "subject.101",
        "inherit"
      ],
      "message": "Unrecognized key: \\"allways\\""
    }
  ]
}"
`;

exports[`parseRoleBootYaml given: [case15] a subject that declares its \`always\` inheritance when: [t3] inherit sits on the always section itself then: it throws — only a subject inherits always 1`] = `
"✋ ConstraintError: boot.yml declares \`inherit\` on the \`always\` section — only a subject inherits \`always\`

{
  "path": "boot.yml",
  "section": "always",
  "hint": "move \`inherit: { always: false }\` into the \`subject.*\` section that should shed \`always\`"
}"
`;
