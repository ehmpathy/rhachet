exports[`assertRoleFocusDeclared given: [case1.b] a typed focus on init, which \`prepare:rhachet\` may have run (U6) when: [t0] the focus names an undeclared subject then: the hint names the typo fix and the replay fix with --prep 1`] = `
"✋ ConstraintError: role 'mechanic' declares no subject 'gone'

{
  "role": "mechanic",
  "focus": [
    "gone"
  ],
  "declared": [
    "code.prod",
    "flow"
  ],
  "hint": "focus one of: mechanic::code.prod, mechanic::flow. if \`prepare:rhachet\` ran this init, its replay names a subject the role dropped; rewrite it with \`rhx init --prep --roles +mechanic::<one of code.prod, flow>\`"
}"
`;

