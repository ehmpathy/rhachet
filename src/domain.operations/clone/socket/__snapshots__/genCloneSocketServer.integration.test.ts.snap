exports[`genCloneSocketServer.integration given: [case20] a caller the lookup cannot name in \`ss\` when: [t0] a say is dispatched then: it is refused as auth-denied, with the copy that names the fix 1`] = `
"💥 MalfunctionError: clone refused the message: the caller is not the same unix user as the clone — a clone socket accepts only its own user; run the say as the user that enrolled the clone

{
  "socketPath": "__SOCKET__",
  "reason": "auth-denied"
}"
`;

exports[`genCloneSocketServer.integration given: [case21] a caller held by a process this user cannot read when: [t0] a say is dispatched then: it is refused as auth-denied, with the copy that names the fix 1`] = `
