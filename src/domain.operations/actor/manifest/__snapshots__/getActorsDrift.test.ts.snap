exports[`asActorsDriftReportLines given: [case1] drift both ways, with a caution when: [t0] the report is rendered then: it matches the snapshot 1`] = `
"🎭 actors.yml
   ├─ repo actor = @builder
   ├─ 2 actor(s), 6 role(s) declared
   ├─ short → restored
   │  └─ bhrain/learner ↺ linked, via @ehmpathy/builder
   ├─ extra → kept, undeclared
   │  └─ ghlitch/observer
   │     ├─ to keep it, declare \`ghlitch/observer\` in .agent/actors.yml
   │     └─ to drop it, unlink .agent/repo=ghlitch/role=observer
   └─ cautions
      └─ @builder removes -driver, which @ehmpathy/builder does not hold
"
`;

