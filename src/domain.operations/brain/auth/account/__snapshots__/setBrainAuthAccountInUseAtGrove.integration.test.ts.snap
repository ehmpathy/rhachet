exports[`setBrainAuthAccountInUseAtGrove given: [case3b] the provider is busy when the grove's account is read when: [t0] b is put to use then: it fails as a malfunction to retry, never a human fault 1`] = `
[Error: 💥 MalfunctionError: the grove's signed-in account could not be read

{
  "status": "rate-limited",
  "hint": "the grove is untouched; the provider is busy or unreachable. wait a few minutes, then retry"
}]
`;

