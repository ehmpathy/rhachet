exports[`fillKeyrackKeys.integration given: [case10] a dangerous credential at every declared reach when: [t0] fill runs with --allow-dangerous then: every reach is accepted as-is, none is re-set 1`] = `
"
🔐 keyrack fill (env: test, keys: 1, owners: 1)

🔑 key 1/1, DANGER_KEY, for 1 owner
   └─ for owner case10
      ├─ at reach default
      │  └─ 🟡 found vaulted under testorg.test.DANGER_KEY dangerously, allowed via --allow-dangerous
      ├─ at reach beav@ehmpathy.com
      │  └─ 🟡 found vaulted under testorg.test.DANGER_KEY dangerously, allowed via --allow-dangerous
      └─ at reach vlad@ehmpathy.com
         └─ 🟡 found vaulted under testorg.test.DANGER_KEY dangerously, allowed via --allow-dangerous

🔐 keyrack fill complete (3/3 keys verified)
"
`;

