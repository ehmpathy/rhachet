exports[`asKeyrackStatusKeyBranch given: [case7] an sso key whose renew halted on a persistent fault when: [t0] the grant has expired then: it renders the halted shape 1`] = `
[
  "   └─ ahbode.camp.AWS_PROFILE",
  "      ├─ env: camp",
  "      ├─ org: ahbode",
  "      ├─ expired",
  "      ├─ renewed = 2x",
  "      └─ halted",
  "         ├─ renew stopped on a fault it could not clear",
  "         ├─ aws configure export-credentials failed with unexpected error",
  "         │  └─ full error",
  "         │     └─ rhx keyrack status --owner ehmpath --env camp --json",
  "         └─ fix",
  "            ├─ rhx keyrack unlock --owner ehmpath --env camp",
  "            │  ├─ once the fault above clears",
  "            │  └─ if the sso session ended meanwhile, a human must finish the browser login",
  "            └─ rhx keyrack daemon prune --owner ehmpath",
  "               ├─ if the fault lives in the daemon's own env",
  "               ├─ drops every key the daemon holds; a key kept only in the daemon will not come back",
  "               └─ then unlock again",
]
`;

exports[`asKeyrackStatusKeyBranch given: [case7] an sso key whose renew halted on a persistent fault when: [t1] the error carries a helpful error metadata block then: it renders the headline-only shape 1`] = `
[
  "   └─ ahbode.camp.AWS_PROFILE",
  "      ├─ env: camp",
  "      ├─ org: ahbode",
  "      ├─ expired",
  "      ├─ renewed = 2x",
  "      └─ halted",
  "         ├─ renew stopped on a fault it could not clear",
  "         ├─ 💥 MalfunctionError: aws configure export-credentials failed with unexpected error",
  "         │  └─ full error",
  "         │     └─ rhx keyrack status --owner ehmpath --env camp --json",
  "         └─ fix",
  "            ├─ rhx keyrack unlock --owner ehmpath --env camp",
  "            │  ├─ once the fault above clears",
  "            │  └─ if the sso session ended meanwhile, a human must finish the browser login",
  "            └─ rhx keyrack daemon prune --owner ehmpath",
  "               ├─ if the fault lives in the daemon's own env",
  "               ├─ drops every key the daemon holds; a key kept only in the daemon will not come back",
  "               └─ then unlock again",
]
`;

exports[`asKeyrackStatusKeyBranch given: [case7] an sso key whose renew halted on a persistent fault when: [t2] the halt was a code defect then: it renders the defect-halt shape 1`] = `
[
  "   └─ ahbode.camp.AWS_PROFILE",
  "      ├─ env: camp",
  "      ├─ org: ahbode",
  "      ├─ expired",
  "      └─ halted",
  "         ├─ renew stopped on a code defect, which no retry clears",
  "         ├─ 💥 defect TypeError: grant.expiresAt is not a function",
  "         │  └─ full error",
  "         │     └─ rhx keyrack status --owner ehmpath --env camp --json",
  "         ├─ fix",
  "         │  └─ rhx keyrack unlock --owner ehmpath --env camp",
  "         │     └─ holds the key to its ttl; the renew may halt again",
  "         └─ report the defect, with its full error above",
]
`;

