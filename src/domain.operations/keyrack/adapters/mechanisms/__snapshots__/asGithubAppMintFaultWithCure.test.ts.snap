// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`asGithubAppMintFaultWithCure given: [case1] each mint refusal, under each vault cure when: [t0] a refused key (401) then: the tip a human reads matches snapshot 1`] = `"failed to mint github app token — github refused the stored private key (401) — fix: the stored blob is stale or belongs to another app, or this box's clock is off (a skewed jwt also draws a 401; check the box's time sync first). if the app key was rotated, re-file the current blob; <the current blob> | rhx keyrack set --owner ehmpath --key @all.all.EHMPATH_BEAVER_GITHUB_TOKEN --vault os.secure --mech EPHEMERAL_VIA_GITHUB_APP --source @stdin"`;

exports[`asGithubAppMintFaultWithCure given: [case1] each mint refusal, under each vault cure when: [t1] a refused installation (404) then: the tip a human reads matches snapshot 1`] = `"failed to mint github app token — github refused the stored installation (404) — fix: the blob's appId or installationId names none github will serve: the app was uninstalled or suspended, the blob names another org, or its appId names no app. check the app's id and install, then re-file the current blob; <the current blob> | rhx keyrack set --owner ehmpath --key @all.all.EHMPATH_BEAVER_GITHUB_TOKEN --vault os.secure --mech EPHEMERAL_VIA_GITHUB_APP --source @stdin"`;

exports[`asGithubAppMintFaultWithCure given: [case1] each mint refusal, under each vault cure when: [t2] an invalid private key then: the tip a human reads matches snapshot 1`] = `"failed to mint github app token — the stored private key (.pem) is not a valid rsa key — fix: re-set the key with a valid github app private key (.pem) file; <the current blob> | rhx keyrack set --owner ehmpath --key @all.all.EHMPATH_BEAVER_GITHUB_TOKEN --vault os.secure --mech EPHEMERAL_VIA_GITHUB_APP --source @stdin"`;
