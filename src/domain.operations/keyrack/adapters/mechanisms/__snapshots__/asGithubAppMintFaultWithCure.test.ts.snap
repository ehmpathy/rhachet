// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`asGithubAppMintFaultWithCure given: [case1] each mint refusal, under each vault cure when: [t0] a refused installation (404) then: the tip a human reads matches snapshot 1`] = `"failed to mint github app token — github refused the stored installation (404) — fix: the blob's installationId names no installation this app may use: the app was uninstalled, suspended, or the blob names another org. check the app's install, then re-file the current blob: <the current blob> | rhx keyrack set --owner ehmpath --key @all.all.EHMPATH_BEAVER_GITHUB_TOKEN --vault os.secure --mech EPHEMERAL_VIA_GITHUB_APP --source @stdin"`;

exports[`asGithubAppMintFaultWithCure given: [case1] each mint refusal, under each vault cure when: [t0] a refused key (401) then: the tip a human reads matches snapshot 1`] = `"failed to mint github app token — github refused the stored private key (401) — fix: the stored blob is stale or belongs to another app, or this box's clock is off (a skewed jwt also draws a 401; check the box's time sync first). if the app key was rotated, re-file the current blob: <the current blob> | rhx keyrack set --owner ehmpath --key @all.all.EHMPATH_BEAVER_GITHUB_TOKEN --vault os.secure --mech EPHEMERAL_VIA_GITHUB_APP --source @stdin"`;

exports[`asGithubAppMintFaultWithCure given: [case1] each mint refusal, under each vault cure when: [t0] an invalid private key then: the tip a human reads matches snapshot 1`] = `"failed to mint github app token — the stored private key (.pem) is not a valid rsa key — fix: re-file a blob that holds a valid github app private key (.pem): <the current blob> | rhx keyrack set --owner ehmpath --key @all.all.EHMPATH_BEAVER_GITHUB_TOKEN --vault os.secure --mech EPHEMERAL_VIA_GITHUB_APP --source @stdin"`;
