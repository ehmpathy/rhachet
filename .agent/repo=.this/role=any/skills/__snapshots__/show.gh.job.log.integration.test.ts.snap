// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`show.gh.job.log given: [case1] a completed test run of this repo when: [t0] the jobs of the run are listed then: it exits 0 and names the job by id, with a conclusion 1`] = `
"🐢 heres the wave...

🐚 show.gh.job.log --run <id>
   └─ jobs (id · conclusion · seconds · name)
      <log line>
"
`;

exports[`show.gh.job.log given: [case1] a completed test run of this repo when: [t1] one job log is read with a short tail then: it exits 0 with the repo, the line count, and the tail 1`] = `
"🐢 heres the wave...

🐚 show.gh.job.log --job <id>
   ├─ repo = ehmpathy/rhachet
   ├─ N lines
   ├─ failure lines
      <log line>
   └─ last 5 lines
      <log line>
"
`;

exports[`show.gh.job.log given: [case1] a completed test run of this repo when: [t2] one job log is read with a grep then: it exits 0 and each shown line holds the match 1`] = `
"🐢 heres the wave...

🐚 show.gh.job.log --job <id>
   ├─ repo = ehmpathy/rhachet
   ├─ N lines
   └─ lines that match 'Complete job'
      <log line>
"
`;

exports[`show.gh.job.log given: [case1] a completed test run of this repo when: [t3] a job id that does not exist is read then: it exits 1 with a MalfunctionError that names the job 1`] = `
"gh: Not Found (HTTP 404)
💥 MalfunctionError: gh api could not read the log of job 1
"
`;

exports[`show.gh.job.log given: [case2] bad input when: [t0] --job is not a number then: it exits 2 and names the fix 1`] = `
"✋ ConstraintError: --job must be a number, got 'abc'
   └─ fix: --job 119598027389 (the number after /job/ in a check url)
"
`;

exports[`show.gh.job.log given: [case2] bad input when: [t1] an unknown arg is passed then: it exits 2 and points at the help 1`] = `
"✋ ConstraintError: unknown arg '--jobs'
   └─ fix: rhx show.gh.job.log --help
"
`;

exports[`show.gh.job.log given: [case2] bad input when: [t2] --help is asked for then: it exits 0 and the help is locked 1`] = `
"🐢 heres the wave...

🐚 show.gh.job.log — the plain-text log of one github actions job
   ├─ usage: rhx show.gh.job.log --job <id> [--tail <n>] [--grep '<regex>']
   ├─ example: rhx show.gh.job.log --job 119598027389 --grep 'FAIL|✕|Error'
   └─ exit: 0 shown, 1 malfunction, 2 bad input
"
`;
