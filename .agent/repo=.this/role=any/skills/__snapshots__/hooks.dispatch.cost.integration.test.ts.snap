   │  ├─ hooks claude starts = 2
   │  ├─ processes forked = __N__ (__N__ execs)
   │  ├─ cpu per call = __N__ ms
   │  └─ peak rss of one process = __N__ MB
   └─ after = $DIR/settings.after.json
      ├─ hooks claude starts = 1
      ├─ processes forked = __N__ (__N__ execs)
      ├─ cpu per call = __N__ ms
      └─ peak rss of one process = __N__ MB
"
`;

