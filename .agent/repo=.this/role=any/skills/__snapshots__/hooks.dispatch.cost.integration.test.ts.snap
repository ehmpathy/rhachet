exports[`hooks.dispatch.cost given: [case1] a before shape of two blocker hooks, and an after shape of one dispatcher over them when: [t0] the verdicts are read then: the read matches the snapshot 1`] = `
"heres the read...

🧮 hooks.dispatch.cost --what verdicts --event PreToolUse --tool Bash
   ├─ before exit = 2 (2 hooks)
   ├─ after exit = 2 (1 hook)
   ├─ blocker stderr byte-equal = yes
   ├─ stdout byte-equal = n/a (block)
   └─ blocked-by lines after = 2
"
`;

exports[`hooks.dispatch.cost given: [case1] a before shape of two blocker hooks, and an after shape of one dispatcher over them when: [t1] the cost is read, one run per shape then: the cost read matches the snapshot, with its measured numbers masked 1`] = `
