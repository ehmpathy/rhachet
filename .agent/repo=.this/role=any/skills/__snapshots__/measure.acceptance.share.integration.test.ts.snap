exports[`measure.acceptance.share given: [case3] a measure on a 12-core box at two widths when: [t0] the tree is rendered then: it reads the box as quiet, and each width with its slowdown and peak 1`] = `
"🧮 measure.acceptance.share
   ├─ box = 12 cores, baseline load 1.4, baseline cpu psi 2%
   ├─ quiet = yes
   ├─ peer solo = 2.00s (median of 3)
   ├─ beside a live suite
   │  ├─ width 25%
   │  │  ├─ peer = 2.30s (median of 3), slowdown 15%
   │  │  ├─ peak load = 5.2, peak cpu psi = 31%
   │  │  └─ suite = 94s, exit 0
   │  └─ width 50%
   │     ├─ peer = 3.10s (median of 3), slowdown 55%
   │     ├─ peak load = 9.8, peak cpu psi = 58%
   │     └─ suite = 61s, exit 0
   │
   └─ record = .log/role=any/skill=measure.acceptance.share/20000101T000000000Z.json"
`;

exports[`measure.acceptance.share given: [case5] a measure on a busy box with no psi, where one width ran too short when: [t0] the tree is rendered then: it reads quiet = no, psi as n/a, and the short width as n/a with the fix 1`] = `
"🧮 measure.acceptance.share
   ├─ box = 8 cores, baseline load 6.2, baseline cpu psi n/a
   ├─ quiet = no (baseline psi ≥ 10% or load ≥ half the cores)
   │  └─ numbers from a busy box are no measure of the bound; re-run on a quiet box
   ├─ peer solo = 2.00s (median of 3)
   ├─ beside a live suite
   │  └─ width 25%
   │     ├─ peer = n/a, the suite ended before a peer run finished; widen --scope
   │     ├─ peak load = 7.9, peak cpu psi = n/a
   │     └─ suite = 12s, exit 0
   │
   └─ record = .log/role=any/skill=measure.acceptance.share/20000101T000000001Z.json"
`;

exports[`measure.acceptance.share given: [case7] a measure that fails when: [t0] the peer command fails, a system-fix error with a hint then: it reads 💥 MalfunctionError once, names the hint, and exits 1 1`] = `
"💥 MalfunctionError: the peer command failed
   └─ run the --peer command alone in a shell; it must exit 0 within the cap
"
`;

exports[`measure.acceptance.share given: [case7] a measure that fails when: [t1] the scope matches no acceptance file, live then: it refuses with ✋ ConstraintError and exit 2, before any measure begins 1`] = `
"✋ ConstraintError: no acceptance file matched the scope
   └─ each --scope is a jest path regex, e.g. --scope 'blackbox/cli/acceptance\\.shares-the-box'
"
`;

exports[`measure.acceptance.share given: [case7] a measure that fails when: [t3] the repo has no tsx installed then: it fails with exit 1 and names the install 1`] = `
