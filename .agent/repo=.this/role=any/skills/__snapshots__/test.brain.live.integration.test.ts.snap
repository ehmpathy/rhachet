exports[`test.brain.live given: [case3] a seat that asks the skill to describe itself when: [t0] --help then: it prints usage, inputs and an example 1`] = `
"🐢 test.brain.live — run tier-3 live-brain tests on demand, scoped
   ├─ usage
   │  └─ rhx test.brain.live --what <integration|acceptance> --scope <scope> [--mode apply]
   ├─ inputs
   │  ├─ --what   integration | acceptance (required)
   │  └─ --scope  a git.repo.test scope (required, repeatable; at least one a path scope)
   ├─ guarantee
   │  ├─ sets BRAIN_LIVE_SCOPE=all for this run only
   │  ├─ refuses a scope that matches more than 3 tier-3 suites
   │  ├─ every other flag passes to git.repo.test, which refuses one it does not know
   │  ├─ without --mode apply, git.repo.test shows the matched files and runs none
   │  └─ exit 2 = bad input · else the exit of git.repo.test
   └─ example
      ├─ rhx test.brain.live --what integration --scope path://actorAsk
      └─ rhx test.brain.live --what integration --scope path://actorAsk --mode apply
"
`;
