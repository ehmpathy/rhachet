"🧮 boot.adherence.probe — does a clone follow a brief its boot carries?
   ├─ usage
   │  └─ rhx boot.adherence.probe --prompt <text> --expect <text> [--trials <n>] [--roles <spec>] [--model <model>]
   ├─ options
   │  ├─ --prompt   the ask each trial sends
   │  ├─ --expect   the text a reply must hold to count as adherent (a fixed string)
   │  ├─ --trials   how many fresh sessions; 5 when absent
   │  ├─ --roles    the --roles spec passed to rhx enroll; -driver when absent
   │  └─ --model    the brain model; haiku when absent
   ├─ exits
   │  ├─ 0 = measured
   │  ├─ 1 = a trial failed to return a reply
   │  └─ 2 = bad input
   ├─ examples
   │  └─ rhx boot.adherence.probe --prompt '<an ask a brief dictates the reply to>' --expect '<the text that brief dictates>'
   └─ spends real tokens — one short -p call per trial
"
`;

exports[`boot.cache.skills given: [case4] boot.adherence.probe when: [t1] --trials is no positive integer then: it refuses with exit 2 and shows a valid form 1`] = `
