exports[`boot.cache.skills given: [case2] clone.cache.usage when: [t0] help is asked then: it exits 0 and names every option 1`] = `
"🧮 clone.cache.usage — the prompt-cache usage of each api call in a clone
   ├─ usage
   │  └─ rhx clone.cache.usage (--transcript <path.jsonl> | --clone <dir>) [--head <n>]
   ├─ options
   │  ├─ --transcript   a brain-cli transcript (.jsonl); may repeat
   │  ├─ --clone        a clone dir; reads every history/*.jsonl in it
   │  └─ --head         show only the first n calls of each transcript; all when absent
   ├─ exits
   │  ├─ 0 = shown
   │  ├─ 1 = a transcript could not be parsed
   │  └─ 2 = bad input — an absent value, an unknown flag, or no transcript found
   └─ examples
      ├─ rhx clone.cache.usage --clone .agent/.actors/actor.via.repo=ambient/clones/serial=<uuid>
      └─ rhx clone.cache.usage --transcript <path.jsonl> --head 5
"
`;

