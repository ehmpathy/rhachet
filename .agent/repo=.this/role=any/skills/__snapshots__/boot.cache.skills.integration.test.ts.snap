exports[`boot.cache.skills given: [case1] boot.cache.probe when: [t0] help is asked then: it exits 0 and names every option 1`] = `
"🧮 boot.cache.probe — does a new session of an actor read its boot from cache?
   ├─ usage
   │  └─ rhx boot.cache.probe [--roles <spec>] [--model <model>] [--diff] [--across <where>]
   ├─ options
   │  ├─ --roles    the --roles spec passed to rhx enroll; -driver when absent, so a probe never drives a bound route
   │  ├─ --model    the brain model; haiku when absent
   │  ├─ --diff     log both raw request bodies, list their blocks, name the first byte that differs
   │  └─ --across   where the second session runs; one of tree or worktree
   │     ├─ tree      this worktree, the default
   │     └─ worktree  a temp git worktree of HEAD, so the second session runs at another path
   ├─ exits
   │  ├─ 0 = measured, and the verdict is ✓ or ✗
   │  ├─ 1 = the measure failed — a probe returned no usage, or --diff found no request bodies
   │  └─ 2 = bad input, or an enroll refused its args
   ├─ examples
   │  ├─ rhx boot.cache.probe
   │  ├─ rhx boot.cache.probe --model sonnet
   │  ├─ rhx boot.cache.probe --diff
   │  ├─ rhx boot.cache.probe --across worktree
   │  └─ rhx boot.cache.probe --roles '-driver +architect'
   └─ spends real tokens — two short -p calls
"
`;

exports[`boot.cache.skills given: [case1] boot.cache.probe when: [t1] --across holds a value outside its set then: it refuses with exit 2 and names the valid set 1`] = `
