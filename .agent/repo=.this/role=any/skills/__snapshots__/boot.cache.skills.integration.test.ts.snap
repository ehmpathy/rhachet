exports[`boot.cache.skills given: [case1] boot.cache.probe when: [t9] --diff, and the two requests differ only in the first message then: it names the first byte that differs, and that it lies after the boot 1`] = `
"🧮 boot.cache.probe --roles '-driver' --model haiku --across tree
   ├─ prompts differ per run, as two real sessions do
   ├─ first run = 137110 tokens of prefix
   │  ├─ 10 fresh
   │  ├─ 4805 cache write
   │  └─ 132295 cache read
   ├─ the first run read the boot too, since a session of this boot wrote it within the cache ttl
   ├─ second run = 137110 tokens of prefix
   │  ├─ 10 fresh
   │  ├─ 4805 cache write
   │  └─ 132295 cache read
   ├─ ✓ the second session read the boot from cache
   ├─ system blocks, in request order (first run)
   │  ├─ [0] 38 chars · breakpoint · <brief.say path="x">a boot</brief.say>
   │  └─ the boot splits at its boundary line when claude honors it
   ├─ first message blocks, in request order (first run)
   │  ├─ [0] 2 chars · OK
   │  └─ a breakpoint ends the prefix the cache can share
   ├─ breakpoints outside the first message
   │  ├─ system = 1 marked
   │  └─ tools = 0 marked
   │
   └─ request bodies
      ├─ first = .log/role=any/skill=boot.cache.probe/<run>/first/<body>
      ├─ second = .log/role=any/skill=boot.cache.probe/<run>/second/<body>
      ├─ first byte that differs = 63 of the request file
      ├─ in messages, after the boot, so the boot prefix is still shared
      ├─ first, around it
      │  └─ {"messages":[{"role":"user","content":[{"type":"text","text":"OK"}]}],"system":[{"type":"text","text":"<brief.say path=\\"x\\">a boot</brief.say>","cache_control":{"type":"ephemeral"}}]}
      └─ second, around it
         └─ {"messages":[{"role":"user","content":[{"type":"text","text":"YES"}]}],"system":[{"type":"text","text":"<brief.say path=\\"x\\">a boot</brief.say>","cache_control":{"type":"ephemeral"}}]}
"
`;

